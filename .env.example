# Supabase — get these from your project's Dashboard → Settings → API Keys
# (Project URL and Publishable key. The publishable key starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Public site URL — used for OAuth redirects.
# Local dev: http://localhost:3000
# Production: https://your-domain.vercel.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps API key. The browser uses this for the Maps JS embed; the
# server falls back to it for Places / photos / geocoding if the optional
# GOOGLE_MAPS_API_KEY below isn't set. Needs Maps JavaScript API,
# Places API (New), and Geocoding API enabled. Restrict by HTTP referrer
# in Google Cloud Console so other sites can't reuse it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Optional: separate server-only Maps key. If set, takes precedence over
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY for /api/search, /api/photo,
# /api/photo-data, /api/reverse-geocode. Useful if you want a referrer-
# restricted public key + an unrestricted (or IP-restricted) server key.
# Leave unset to use the public key on the server too.
# GOOGLE_MAPS_API_KEY=AIza...

# Gemini API key — used only by the /api/generate-site edge proxy.
# Get one at https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=AIza...
