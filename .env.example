# Supabase — get these from your project's Dashboard → Settings → API Keys
# (Project URL and Publishable key. The publishable key starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Public site URL — used for OAuth redirects.
# Local dev: http://localhost:3000
# Production: https://your-domain.vercel.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps API key for the browser-side Maps JS embed. Must have
# Maps JavaScript API enabled and be restricted by HTTP referrer in
# Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# Google Maps API key for server-side calls (Places Text Search, photo
# resolve, reverse geocode). Can be the same value as the NEXT_PUBLIC_
# one, or a separate IP-restricted key.
GOOGLE_MAPS_API_KEY=AIza...

# Gemini API key — used only by the /api/generate-site edge proxy.
# Get one at https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=AIza...
